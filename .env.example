# Public canonical URL used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local content is the default. Set DATA_SOURCE=api only when the SES API is ready.
DATA_SOURCE=mock

# Optional SES API base URLs. Keep real credentials out of this file.
# Server-side API requests prefer API_URL; browser requests use NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
